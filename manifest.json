{
  "manifestVersion": 2,
  "id": "biaoqingbao-app",
  "name": "表情包",
  "version": "0.6.3",
  "entry": "index.js",
  "description": "让小花在回复里根据具体的情绪带出表情包！导入你收藏的表情包，ta 会挑着合情绪的往回复里贴。点“喜欢、应景、不喜欢”，让选图越来越合你口味。另外还能让小花说不同地区的方言，顺便总结你的发言习惯，学你说话！",
  "capabilities": [
    "app/tools.expose-to-model",
    "app/hooks.agent-pre-step",
    "app/hooks.messages-post-assistant",
    "app/hooks.tools-pre-execute",
    "app/process.spawn",
    "app/models.read",
    "app/models.infer",
    "app/agents.read",
    "app/resources.read",
    "app/resources.write",
    "app/sessions.read",
    "app/sessions.manage",
    "app/session.stage-file",
    "app/session.start-turn",
    "app/services.provide",
    "app/input.status",
    "app/input.panels"
  ],
  "contributes": {
    "ui": {
      "inputStatus": [
        {
          "id": "sticker-compose",
          "title": "表情包",
          "icon": "assets/input-icon.svg",
          "tooltip": "打开我的收藏，选图或输入文字发送",
          "toolName": "stickers.open_compose"
        }
      ]
    },
    "cards": [
      {
        "id": "panel",
        "title": "表情包",
        "route": "/panel.html",
        "face": {
          "image": "assets/cover.png"
        },
        "pageIcon": "assets/nav-icon.svg",
        "realization": "page",
        "siteNavEntry": true,
        "cardForm": "flush",
        "titlebar": "solid"
      },
      {
        "id": "paper-plane-message",
        "title": "对话内表情包",
        "description": "聊天流里那张图片卡的载体，用户丢的图和伙伴配的图共用它，由记录里的归属决定长相。",
        "route": "/paper-plane-message.html",
        "face": {
          "image": "assets/cover.png"
        },
        "cardForm": "flush",
        "titleMode": "hide"
      }
    ],
    "messageRenderers": [
      {
        "customType": "paper-plane-image",
        "cardId": "paper-plane-message"
      },
      {
        "customType": "partner-sticker",
        "cardId": "paper-plane-message"
      }
    ]
  },
  "icon": "assets/icon.png",
  "network": {
    "allowedHosts": [
      "api.siliconflow.cn",
      "api.typesafe.ai",
      "api.github.com"
    ],
    "methods": [
      "GET",
      "POST"
    ],
    "defaultTimeoutMs": 30000
  },
  "minAppVersion": "0.1059.0"
}
